# ---------------------------------------------------------------------------
# Lumbar_MarkAny -- .gitignore
#
# This repository is PUBLIC. It holds code, documentation, manifests and small
# derived tables. It must never hold raw patient-adjacent imaging, bulk public
# datasets (re-downloadable via scripts/data/), model weights, or credentials.
#
# Rule of thumb: if it can be regenerated by a script in scripts/, or if it is
# larger than a few MB, it does not belong in Git.
# ---------------------------------------------------------------------------

# ---- Data lake (re-acquire with scripts/data/*) ---------------------------
data/raw/
data/downloads/
data/extracted/
data/cache/
data/processed/
data/external/
# Keep the small, human-curated registry/manifest layer:
!data/registry/
!data/manifests/
!data/splits/
!data/samples/
# ...but never the bulky discovery dumps inside it:
data/registry/discovery_raw/
data/registry/literature_raw/

# ---- Models, checkpoints, experiment binaries -----------------------------
models/
checkpoints/
runs/
wandb/
mlruns/
*.ckpt
*.pth
*.pt
*.onnx
*.safetensors
*.h5
*.pb

# Experiment outputs: keep configs/logs/metrics (tracked explicitly below),
# drop heavyweight artefacts.
experiments/**/best.pt
experiments/**/last.pt
experiments/**/predictions/*.npz
experiments/**/predictions/*.png

# ---- Archives and bulk binaries -------------------------------------------
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.rar
*.nii
*.nii.gz
*.mnc
*.dcm
*.mhd
*.raw
*.stl
*.ply

# ---- Environments and tooling ---------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Secrets (never commit) -----------------------------------------------
.env
.env.*
*.key
*.pem
credentials.json
secrets.yaml
token.txt

# ---- OS / editor noise -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ---- Scratch ---------------------------------------------------------------
temp/
tmp/
scratch/
exports/large/
nohup.out

# ---- Explicit keeps --------------------------------------------------------
# Small, legally redistributable sample assets and publication figures are
# tracked deliberately; add them with `git add -f` if a rule above catches them.
!visuals/**/*.png
!deliverables/**/*.png
!deliverables/**/*.svg
!figures/**/*.svg
!figures/**/*.png
